[Unit]
Description=Amarktai Daily Health Report
Requires=amarktai-monitor.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/amarktai/app
Environment="API_URL=http://127.0.0.1:8000"
Environment="LOG_FILE=/var/log/amarktai/backend.log"
Environment="ALERT_EMAIL=amarktainetwork@gmail.com"
EnvironmentFile=/etc/amarktai/amarktai.env

# Send daily report
ExecStart=/var/amarktai/app/backend/.venv/bin/python3 /var/amarktai/app/scripts/health_monitor.py report

[Install]
WantedBy=multi-user.target
