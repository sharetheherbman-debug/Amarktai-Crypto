[Unit]
Description=Amarktai Health Monitor
After=network.target amarktai-api.service
Wants=amarktai-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/amarktai/app
Environment="API_URL=http://127.0.0.1:8000"
Environment="LOG_FILE=/var/log/amarktai/backend.log"
Environment="ALERT_EMAIL=amarktainetwork@gmail.com"
Environment="HEALTH_CHECK_INTERVAL=300"
EnvironmentFile=/etc/amarktai/amarktai.env

# Run health monitor in daemon mode
ExecStart=/var/amarktai/app/backend/.venv/bin/python3 /var/amarktai/app/scripts/health_monitor.py daemon

# Restart on failure
Restart=always
RestartSec=30

# Logging
StandardOutput=append:/var/log/amarktai/monitor.log
StandardError=append:/var/log/amarktai/monitor.log

[Install]
WantedBy=multi-user.target
