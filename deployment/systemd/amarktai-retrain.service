[Unit]
Description=Amarktai XGBoost Daily Retraining
After=network.target mongod.service
Wants=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/amarktai/app/Amarktai-Crypto/backend
EnvironmentFile=/etc/amarktai/amarktai.env
ExecStart=/var/amarktai/app/Amarktai-Crypto/backend/.venv/bin/python \
    /var/amarktai/app/Amarktai-Crypto/backend/scripts/retrain_xgboost.py \
    --lookback-days 30
StandardOutput=append:/var/log/amarktai/retrain.log
StandardError=append:/var/log/amarktai/retrain.log
SyslogIdentifier=amarktai-retrain

[Install]
WantedBy=multi-user.target
