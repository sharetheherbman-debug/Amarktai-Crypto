[Unit]
Description=Amarktai Daily Health Report
Requires=amarktai-monitor.service

[Service]
Type=oneshot
User=amarktai
Group=amarktai
WorkingDirectory=/opt/amarktai
Environment="API_URL=http://127.0.0.1:8000"
Environment="LOG_FILE=/var/log/amarktai/backend.log"
Environment="ALERT_EMAIL=amarktainetwork@gmail.com"
EnvironmentFile=/opt/amarktai/.env

# Send daily report
ExecStart=/opt/amarktai/venv/bin/python3 /opt/amarktai/scripts/health_monitor.py report

[Install]
WantedBy=multi-user.target
