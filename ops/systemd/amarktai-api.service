# ============================================================================
# Amarktai Crypto – Canonical Systemd Service Unit
# ops/systemd/amarktai-api.service
#
# INSTALL (run by ops/redeploy_production.sh automatically)
#   sudo cp ops/systemd/amarktai-api.service /etc/systemd/system/amarktai-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable amarktai-api
#   sudo systemctl start amarktai-api
#
# CANONICAL PATHS (do NOT change without updating nginx + all deploy scripts)
#   App root:    /var/amarktai/app/Amarktai-Crypto   (git clone target)
#   Backend:     /var/amarktai/app/Amarktai-Crypto/backend
#   Venv:        /var/amarktai/app/Amarktai-Crypto/backend/.venv
#   Env file:    /etc/amarktai/amarktai.env          (external – never wiped by git)
#   Frontend:    /var/amarktai/app/Amarktai-Crypto/frontend/build  (nginx root)
#   Logs:        /var/log/amarktai/
# ============================================================================

[Unit]
Description=Amarktai Crypto API Server
Documentation=https://github.com/amarktainetwork-blip/Amarktai-Crypto
After=network.target mongod.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/amarktai/app/Amarktai-Crypto/backend

# Python virtual environment
Environment="PATH=/var/amarktai/app/Amarktai-Crypto/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="PYTHONUNBUFFERED=1"

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS ARE LOADED FROM AN EXTERNAL FILE OUTSIDE THE REPO.
# This file is NEVER wiped by git pull / deploy.
# Create once with:
#   sudo mkdir -p /etc/amarktai
#   sudo cp ops/systemd/amarktai-api.service.env.template /etc/amarktai/amarktai.env
#   sudo chmod 600 /etc/amarktai/amarktai.env
#   sudo chown root:www-data /etc/amarktai/amarktai.env
# ─────────────────────────────────────────────────────────────────────────────
EnvironmentFile=/etc/amarktai/amarktai.env

# ── Preflight checks (run before ExecStart) ───────────────────────────────
# Fail fast if critical paths or files are missing.
ExecStartPre=/bin/sh -c 'test -f /etc/amarktai/amarktai.env || (echo "PREFLIGHT FAIL: /etc/amarktai/amarktai.env missing" >&2; exit 1)'
ExecStartPre=/bin/sh -c 'test -d /var/amarktai/app/Amarktai-Crypto/backend || (echo "PREFLIGHT FAIL: backend dir missing" >&2; exit 1)'
ExecStartPre=/bin/sh -c 'test -x /var/amarktai/app/Amarktai-Crypto/backend/.venv/bin/uvicorn || (echo "PREFLIGHT FAIL: venv/uvicorn missing" >&2; exit 1)'
ExecStartPre=/bin/sh -c 'test -w /var/log/amarktai || (echo "PREFLIGHT FAIL: /var/log/amarktai not writable" >&2; exit 1)'
ExecStartPre=/var/amarktai/app/Amarktai-Crypto/backend/.venv/bin/python3 \
    -c "import sys; sys.path.insert(0, '/var/amarktai/app/Amarktai-Crypto/backend'); import server"

# Start command
ExecStart=/var/amarktai/app/Amarktai-Crypto/backend/.venv/bin/uvicorn server:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info

# Restart policy – backs off on repeated crashes, never loops indefinitely
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5

# Logging
StandardOutput=append:/var/log/amarktai/backend.log
StandardError=append:/var/log/amarktai/backend.log
SyslogIdentifier=amarktai-api

# Resource limits
MemoryMax=2G
CPUQuota=150%

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
