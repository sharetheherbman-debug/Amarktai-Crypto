# Frontend Environment Variables

# API Base URL
REACT_APP_API_BASE=http://localhost:8000

# Build Version (auto-populated during build)
# This should be set by CI/CD pipeline to match backend version
REACT_APP_VERSION=dev
REACT_APP_GIT_SHA=

# WebSocket URL (optional, auto-detected if not set)
REACT_APP_WS_URL=

# Cache busting
# Increment this to force cache clear
REACT_APP_CACHE_VERSION=1

# Environment
REACT_APP_ENV=development
