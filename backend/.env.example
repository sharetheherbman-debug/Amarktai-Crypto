# ============================================================================
# Amarktai Crypto - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# For production deployment, ensure all secrets are properly secured

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Option A (recommended): Full URI with DB name embedded (takes priority)
# MONGO_URI=mongodb://127.0.0.1:27017/amarktai_trading
#
# Option B: Separate host URL + DB name
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=amarktai_trading
#
# Legacy alias (still supported):
# DB_NAME=amarktai_trading
#
# IMPORTANT: Production authoritative DB is "amarktai_trading".
# If MONGO_DB resolves to "amarktai" a split-brain warning is emitted.
# Set ALLOW_AMARKTAI_DB=1 to suppress that warning if intentional.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=amarktai_trading

# Optional MariaDB connection (learning persistence, audits)
# Example: mysql+pymysql://amarktai:password@127.0.0.1:3306/amarktai_learning
DATABASE_URL=

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT secret for token signing - MUST be changed in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Admin password for dashboard access and admin unlock features
# REQUIRED FOR PRODUCTION - Must be set for admin endpoints to work
# NO DEFAULT PROVIDED - This is a security requirement
# Generate with: openssl rand -base64 24
# Example: Ashmor12@ (for VPS deployment)
# The system will refuse to start admin features if this is not set
ADMIN_PASSWORD=

# Paper reset password for runtime reset functionality
# REQUIRED if you want to use the paper trading reset feature
# This password is required to confirm paper trading runtime resets
# Generate with: openssl rand -base64 24
PAPER_RESET_PASSWORD=

# ============================================================================
# AI & OPENAI CONFIGURATION
# ============================================================================
# OpenAI API key for AI features (chat, trading decisions, analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use for API key testing (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, gpt-4
OPENAI_TEST_MODEL=gpt-4o-mini

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# Enable/disable email alerts and reports
SMTP_ENABLED=false

# SMTP server configuration (if enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Amarktai Crypto
# Frontend URL used in email links (confirmation URLs, dashboard links)
FRONTEND_URL=https://amarktai.online

# ============================================================================
# TRADING LIMITS & SAFETY
# ============================================================================
# Maximum number of trading bots per user
MAX_BOTS=10

# Maximum daily loss percentage before emergency stop (%)
MAX_DAILY_LOSS_PERCENT=5

# Minimum capital per bot (ZAR)
MIN_BOT_CAPITAL=1000

# Per-bot daily trade cap (enforced by trade_limiter.py)
# Default per exchange: Luno=400, Binance=500, KuCoin=1000, Bybit/Kraken/Bitget/Gate=800
# Override individual exchange limits with MAX_TRADES_PER_BOT_DAILY_<EXCHANGE>
# Override global fallback limit:
MAX_TRADES_PER_BOT_DAILY=400
MAX_TRADES_PER_USER_DAILY=3000

# ============================================================================
# TRADING SAFETY & FEATURE FLAGS
# ============================================================================
# TRADING MODE GATES (CRITICAL SAFETY FEATURE):
# The system will NOT place any orders unless at least one mode is enabled.
# Both can be enabled simultaneously for flexibility.

# Enable paper trading mode (simulated trades, no real money)
# Recommended: Keep enabled for testing and development
# Set to 1 to enable, 0 to disable
PAPER_TRADING=1
# ENABLE_PAPER_TRADING is the flag the backend code reads (true/false).
# Keep this in sync with PAPER_TRADING above. ENABLE_PAPER_TRADING takes precedence.
ENABLE_PAPER_TRADING=true

# Enable live trading mode (DANGER: Uses REAL funds!)
# Requires API keys, double confirmation, and proper risk guardrails
# Set to 1 to enable, 0 to disable
# WARNING: Only enable after thorough testing in paper mode
LIVE_TRADING=0
# ENABLE_LIVE_TRADING is the flag the backend code reads (true/false).
# Keep this in sync with LIVE_TRADING above. ENABLE_LIVE_TRADING takes precedence.
ENABLE_LIVE_TRADING=false

# AUTOPILOT GATES:
# Autopilot will NOT run unless AUTOPILOT_ENABLED=1 AND a trading mode is enabled
# Enable autopilot (automated bot management and profit reinvestment)
# Safe to enable after successful paper trading
# Set to 1 to enable, 0 to disable
AUTOPILOT_ENABLED=0

# Autopilot growth + reinvest feature flags
ENABLE_AUTOPILOT_GROWTH=false
ENABLE_AUTOPILOT_REINVEST=false

# Autopilot profit milestones (ZAR)
AUTOPILOT_PROFIT_MILESTONE_ZAR=1000
AUTOPILOT_REINVEST_MIN_ZAR=100
AUTOPILOT_MAX_BOTS_PER_PLATFORM=0

# Enable live trading (DANGER: Uses REAL funds! Keep false until ready)
# Requires API keys, double confirmation, and proper risk guardrails
ENABLE_LIVE_TRADING=false

# Enable self-learning AI (learns from trading patterns)
# Safe to enable - improves trading strategy over time
ENABLE_SELF_LEARNING=true

# Enable nightly learning job (runs learning at scheduled time)
# Only runs if ENABLE_SELF_LEARNING=true
# Default: disabled for manual control
ENABLE_NIGHTLY_LEARNING=false

# Enable the learning loop service (reads closed paper trades, updates bot params)
# REQUIRED for /api/learning/status to return state != "disabled"
ENABLE_LEARNING_LOOP=true

# Enable learning on live trading data (DANGER: Uses real trading results)
# Keep false unless you want the AI to learn from live trades
# Recommended: Keep false, use paper trading data only
ENABLE_LIVE_LEARNING=false

# Nightly learning schedule (24-hour format, 0-23)
# Default: 2 AM (2) - runs during low activity period
NIGHTLY_LEARNING_HOUR=2

# Enable self-healing (automatically pauses underperforming bots)
# Safe to enable - protects against losses
ENABLE_SELF_HEALING=true

# Enable trading execution (set to true for paper trading; keep false to disable all trading)
# PAPER MODE: Set to true. Live mode additionally requires ENABLE_LIVE_TRADING=true.
ENABLE_TRADING=true

# Enable CCXT exchange connections (safe - needed for market data)
ENABLE_CCXT=true

# ============================================================================
# PAPER TRADING EDGE GATES
# ============================================================================
# Skip trades unless expected move clears costs + buffer
EDGE_GATE_PAPER=true
EDGE_GATE_LIVE=false
EDGE_BUFFER_PCT=0.15
PAPER_MAX_SPREAD_PCT=0.35
PAPER_MIN_ORDERBOOK_NOTIONAL=50000
PAPER_PAIR_WHITELIST_ENABLED=true
PAPER_STALE_EXIT_MINUTES=120

# Paper wallet starting balance (ZAR) – restored on every paper reset
# Default: 30000 ZAR (R30k per user)
PAPER_STARTING_CAPITAL_ZAR=30000

# Split-brain guard: set to 1 to suppress warning when DB resolves to "amarktai"
# ALLOW_AMARKTAI_DB=0

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================
# Fetch.ai API key for AI market signals
FETCHAI_API_KEY=

# FLOKx API key for market intelligence
FLOKX_API_KEY=

# Enable real-time SSE (Server-Sent Events) streaming
ENABLE_REALTIME=true

# Enable background schedulers (autonomous systems, self-healing, etc.)
# REQUIRED for trading bots to tick autonomously — must be true in production
ENABLE_SCHEDULERS=true

# CORS (Cross-Origin Resource Sharing) Configuration
# Determines which frontend domains can access the API

# Allowed origins for production (comma-separated list)
# Example: https://amarktai.online,https://www.amarktai.online
CORS_ALLOWED_ORIGINS=https://amarktai.online,https://www.amarktai.online

# Enable development CORS (allows localhost origins)
# Set to true in development, false in production
# When true, adds: http://localhost:3000, http://localhost:5173, http://127.0.0.1:3000
ENABLE_DEV_CORS=false
# Prevent Python from writing .pyc files (avoids permission issues)
PYTHONDONTWRITEBYTECODE=1

# Server host and port (for direct run, systemd overrides this)
HOST=127.0.0.1
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=production

# ============================================================================
# WALLET TRANSFER LIMITS (Production Safety)
# ============================================================================

# Wallet transfer limits (server-side enforcement)
WALLET_MAX_TRANSFER_ZAR_PER_TX=10000      # Maximum per single transfer (ZAR)
WALLET_MAX_TRANSFER_ZAR_PER_DAY=50000     # Maximum per day (ZAR)
WALLET_MAX_TRANSFER_ZAR_PER_MONTH=200000  # Maximum per month (ZAR)

# Withdrawal security
REQUIRE_2FA_FOR_WITHDRAWALS=1             # 1=require TOTP, 0=disabled
REQUIRE_ADMIN_APPROVAL_ABOVE_ZAR=100000   # Transfers above this need admin approval

# Reserve requirements (working capital model)
MIN_RESERVE_LUNO_ZAR=5000                 # Minimum reserve to keep in Luno (hub)
MIN_RESERVE_PER_EXCHANGE_ZAR=1000         # Minimum reserve per other exchange
