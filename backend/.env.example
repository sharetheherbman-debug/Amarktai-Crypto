# ============================================================================
# Amarktai Crypto - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# For production deployment, ensure all secrets are properly secured

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection URI (used by backend code)
# Local: mongodb://localhost:27017
# Docker: mongodb://127.0.0.1:27017
# Remote: mongodb://username:password@host:port/database
MONGO_URL=mongodb://127.0.0.1:27017

# Database name (used by backend code)
DB_NAME=amarktai_trading

# Optional MariaDB connection (learning persistence, audits)
# Example: mysql+pymysql://amarktai:password@127.0.0.1:3306/amarktai_learning
DATABASE_URL=

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT secret for token signing - MUST be changed in production!
# Generate with: openssl rand -hex 32
# Server will REFUSE to start if this is left as the placeholder.
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Admin password for dashboard access
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=change-me-secure-password

# ============================================================================
# AI & OPENAI CONFIGURATION
# ============================================================================
# OpenAI API key for AI features (chat, trading decisions, analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use for API key testing (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, gpt-4
OPENAI_TEST_MODEL=gpt-4o-mini

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# Enable/disable email alerts and reports
SMTP_ENABLED=false

# SMTP server configuration (if enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Amarktai Crypto

# ============================================================================
# TRADING LIMITS & SAFETY
# ============================================================================
# Maximum number of trading bots per user
MAX_BOTS=10

# Maximum daily loss percentage before emergency stop (%)
MAX_DAILY_LOSS_PERCENT=5

# Minimum capital per bot (ZAR)
MIN_BOT_CAPITAL=1000

# ============================================================================
# TRADING SAFETY & FEATURE FLAGS
# ============================================================================
# TRADING MODE GATES (CRITICAL SAFETY FEATURE):
# The system will NOT place any orders unless at least one mode is enabled.
# Both can be enabled simultaneously for flexibility.
#
# CANONICAL variable names — all runtime code reads these:
#   PAPER_TRADING, LIVE_TRADING, AUTOPILOT_ENABLED  (1/0)
# Legacy aliases accepted for backward compatibility:
#   ENABLE_PAPER_TRADING, ENABLE_LIVE_TRADING, ENABLE_AUTOPILOT  (true/false)

# Enable paper trading mode (simulated trades, no real money)
# Recommended: Keep enabled for testing and development
# Set to 1 to enable, 0 to disable
PAPER_TRADING=1

# Enable live trading mode (DANGER: Uses REAL funds!)
# Requires API keys, double confirmation, and proper risk guardrails
# Set to 1 to enable, 0 to disable
# WARNING: Only enable after thorough testing in paper mode
LIVE_TRADING=0

# AUTOPILOT GATES:
# Autopilot will NOT run unless AUTOPILOT_ENABLED=1 AND a trading mode is enabled
# Enable autopilot (automated bot management and profit reinvestment)
# Safe to enable after successful paper trading
# Set to 1 to enable, 0 to disable
AUTOPILOT_ENABLED=0

# Autopilot growth + reinvest feature flags
ENABLE_AUTOPILOT_GROWTH=false
ENABLE_AUTOPILOT_REINVEST=false

# Autopilot profit milestones (ZAR)
AUTOPILOT_PROFIT_MILESTONE_ZAR=1000
AUTOPILOT_REINVEST_MIN_ZAR=100
AUTOPILOT_MAX_BOTS_PER_PLATFORM=0

# Enable self-learning AI (learns from trading patterns)
# Safe to enable - improves trading strategy over time
ENABLE_SELF_LEARNING=true

# Enable self-healing (automatically pauses underperforming bots)
# Safe to enable - protects against losses
ENABLE_SELF_HEALING=true

# Enable CCXT exchange connections (safe - needed for market data)
ENABLE_CCXT=true

# ============================================================================
# PAPER TRADING EDGE GATES
# ============================================================================
# Skip trades unless expected move clears costs + buffer
EDGE_GATE_PAPER=true
EDGE_GATE_LIVE=false
EDGE_BUFFER_PCT=0.15
PAPER_MAX_SPREAD_PCT=0.35
PAPER_MIN_ORDERBOOK_NOTIONAL=50000
PAPER_PAIR_WHITELIST_ENABLED=true
PAPER_STALE_EXIT_MINUTES=120

# ============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================================
# Fetch.ai API key for AI market signals
FETCHAI_API_KEY=

# Enable real-time SSE (Server-Sent Events) streaming
ENABLE_REALTIME=true

# Enable background schedulers (autonomous systems, self-healing, etc.)
ENABLE_SCHEDULERS=false

# Trading Brain V2 – economics-first engine redesign (paper only initially)
# Enables new cost model, feasibility gate, target policy, regime scorer
NEW_TRADING_BRAIN_V2=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================
# Prevent Python from writing .pyc files (avoids permission issues)
PYTHONDONTWRITEBYTECODE=1

# Server host and port (for direct run, systemd overrides this)
HOST=127.0.0.1
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=production

# ============================================================================
# WALLET TRANSFER LIMITS (Production Safety)
# ============================================================================

# Wallet transfer limits (server-side enforcement)
WALLET_MAX_TRANSFER_ZAR_PER_TX=10000      # Maximum per single transfer (ZAR)
WALLET_MAX_TRANSFER_ZAR_PER_DAY=50000     # Maximum per day (ZAR)
WALLET_MAX_TRANSFER_ZAR_PER_MONTH=200000  # Maximum per month (ZAR)

# Withdrawal security
REQUIRE_2FA_FOR_WITHDRAWALS=1             # 1=require TOTP, 0=disabled
REQUIRE_ADMIN_APPROVAL_ABOVE_ZAR=100000   # Transfers above this need admin approval

# Reserve requirements (working capital model)
MIN_RESERVE_LUNO_ZAR=5000                 # Minimum reserve to keep in Luno (hub)
MIN_RESERVE_PER_EXCHANGE_ZAR=1000         # Minimum reserve per other exchange
